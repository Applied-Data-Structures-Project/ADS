# Real Microsoft sign-in (Entra ID)
#
# Copy this file to .env and fill in the two ids from the app registration.
# These values are public by design: a single-page app uses PKCE, never a secret.
#
# App registration checklist (AUC IT, or a free dev tenant):
#   1. Platform: Single-page application (SPA)
#   2. Redirect URI: http://localhost:5173/auth/callback (plus the deployed URL)
#   3. App roles: Admin, Faculty (students need no role)
#   4. Assign staff users to those roles in Entra

PUBLIC_MSAL_CLIENT_ID=
PUBLIC_MSAL_TENANT_ID=

# Optional. Defaults to <origin>/auth/callback.
PUBLIC_MSAL_REDIRECT_URI=http://localhost:5173/auth/callback

# Demo mode: set to "true" to explore the portal with demo identities while the
# app registration is pending. Ignored in a production build. Turn it off (or
# delete this line) and fill in the two ids above when AUC IT delivers them.
PUBLIC_DEMO_AUTH=false
