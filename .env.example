# Copy to .env and fill in. Never commit .env.
# The server reads these as environment variables, e.g.:
#   export $(grep -v '^#' .env | xargs) && ./build/ads_server

# Backend port (frontend dev proxy expects 18080)
PORT=18080

# Optional: override the SQLite file location (default: db/app.db in the repo)
# DB_PATH=/absolute/path/to/app.db

# LLM provider key for qualitative scoring (used later by src/services)
LLM_API_KEY=

# Copy this file to .env (in the main ADS folder) and fill in the values.
# .env is in .gitignore: share it privately with the team, never on GitHub.

# AI essay coach (console.groq.com -> API Keys)
GROQ_API_KEY=

# Emails to doctors and students (Gmail + app password)
SMTP_USER=aucreccomendationsystem@gmail.com
SMTP_PASS=